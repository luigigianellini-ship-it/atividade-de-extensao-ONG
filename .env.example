# =======================================================
# Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para um arquivo chamado '.env' e configure sua senha.
# O arquivo '.env' está no .gitignore e NUNCA sobe para o GitHub.
# =======================================================

# Porta de execução do servidor
PORT=8000

# Credenciais de Administrador
ADMIN_USER=admin
ADMIN_PASSWORD=sua_senha_secreta_aqui
